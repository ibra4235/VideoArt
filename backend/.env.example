# VideoArt backend — copy to .env and fill as needed

# Analyzer: stub (default) | openai
ANALYZER_PROVIDER=stub

# Required only when ANALYZER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Local data root (uploads + clips + outputs + job JSON). Relative to backend/ cwd or absolute.
DATA_DIR=./data

# Bind host/port (uvicorn)
HOST=0.0.0.0
PORT=8000

# Stub auth: clients may send X-User-Id. No Sign in with Apple in this slice.
ALLOW_ANONYMOUS=true

# Link ingest: real IG/TikTok download is intentionally stubbed (platform ToS).
# analyze-from-link validates URL shape and analyzes a synthetic placeholder.
# Use file upload for real reference videos.

# Founder admin for usage events (GET /admin/events). Send as X-Admin-Token
# header, or ?token= for browser HTML. Change this before any shared deploy.
ADMIN_TOKEN=dev-admin-token
